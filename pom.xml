<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>network.ike</groupId>
        <artifactId>ike-base-parent</artifactId>
        <version>15</version>
    </parent>

    <!-- Explicit even though it matches the parent's: the release
         goals derive the root GA textually, and an inherited groupId
         mis-derived release 4's coherence gate (ike-issues#1068). Every
         released root declares its group; now this one does too. -->
    <groupId>network.ike</groupId>
    <artifactId>ike-lease</artifactId>
    <version>5-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>IKE Working-Set Leases</name>
    <description>
        Single-writer working-set leases across Syncthing-paired machines:
        the protocol and materializer core (a plain-Java library the ws:
        goals can consume), and the IntelliJ enforcement plugin that hosts
        it at the open gesture. Split per IKE-Network/ike-issues#1067.
    </description>

    <modules>
        <module>ike-lease-core</module>
        <module>ike-lease-plugin</module>
    </modules>

    <!--
        Distribution is the internal Nexus (ike-staging, inherited from
        ike-base-parent), never Maven Central. Release behaviour is read
        by the ike: release goals as POM PROPERTIES, not plugin
        <configuration> — names set in a <configuration> block are
        silently reported unknown and do nothing.

        ike.publishToCentral OVERRIDES ike-base-parent, which sets it to
        true; inheriting the parent otherwise opts a repository into
        Maven Central publishing, and nothing here belongs there.
    -->
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <network.ike.tooling__GA__ike-tooling__VERSION>246</network.ike.tooling__GA__ike-tooling__VERSION>
        <network.ike.tooling__GA__ike-tooling__ALIAS>ike-tooling.version</network.ike.tooling__GA__ike-tooling__ALIAS>
        <ike.publishToCentral>false</ike.publishToCentral>
        <!-- No gh-pages site. The site is still BUILT during the draft
             phase, which is where it earns its keep — the javadoc gate. -->
        <publishSite>false</publishSite>
        <!-- Not registered in the cascade. -->
        <ike.skip.orgSite>true</ike.skip.orgSite>
    </properties>

    <build>
        <plugins>
            <!-- Releases run through the IKE release goals. No executions —
                 the declaration pins the version the `ike:` prefix resolves
                 to, so a release is reproducible. -->
            <plugin>
                <groupId>network.ike.tooling</groupId>
                <artifactId>ike-maven-plugin</artifactId>
                <version>${network.ike.tooling__GA__ike-tooling__VERSION}</version>
            </plugin>
        </plugins>
    </build>
</project>
