<idea-plugin>
    <id>network.ike.lease</id>
    <name>IKE Working-Set Leases</name>
    <!-- Filtered from the Maven project version. Without it IntelliJ
         shows the IDE build number as the plugin's version, which reads
         as though the plugin were part of the platform. -->
    <version>${project.version}</version>
    <vendor email="kec@knowledge.design" url="https://ike.network">IKE Network</vendor>

    <description><![CDATA[
        Enforces single-writer working-set leases across Syncthing-paired
        machines. Opening a project takes its lease and closing it returns
        it; a lease held live by another machine raises a recall dialog.
        When this machine is fenced by a recall elsewhere, open documents
        are saved and the project is closed so the work reaches the machine
        that recalled it.
        <br/><br/>
        IDE compiles take the working set's build lock, the one
        ike-workspace-extension's Maven builds take, so an IDE compile and
        a Maven build of the same tree never write its classes at once.
        <br/><br/>
        Design: <code>dev-working-set-lease</code> in ike-lab-documents;
        implementation tracked in IKE-Network/ike-issues#1002.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- The sibling local-origin guard reads git push targets
         (GitPushTarget → GitRemote), so the git plugin's classes must be
         visible to this plugin's classloader. -->
    <depends>Git4Idea</depends>
    <!-- IntelliJ's compiler API lives in the Java plugin; where it is, IDE
         compiles take the working set's build lock (ike-issues#1315). -->
    <depends optional="true" config-file="ike-lease-java.xml">com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="IKE Working-Set Leases"
                           displayType="BALLOON"/>
        <!-- Refuses pushes from a sibling working set to anything but its
             local parent (ike-issues#992, #1057). -->
        <prePushHandler implementation="network.ike.lease.SiblingPrePushGuard"/>
        <!-- Settings → Tools → IKE Build Lock: turns the compile-time build
             lock off (ike-issues#1315). -->
        <applicationConfigurable parentId="tools"
                                 instance="network.ike.lease.BuildLockConfigurable"
                                 id="network.ike.lease.buildLock"
                                 displayName="IKE Build Lock"/>
    </extensions>

    <applicationListeners>
        <listener class="network.ike.lease.LeaseProjectListener"
                  topic="com.intellij.openapi.project.ProjectManagerListener"/>
    </applicationListeners>
</idea-plugin>
